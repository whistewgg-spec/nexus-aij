# Copy to .env. Keep NEXUS_API_TOKEN private; never commit .env.
# Generate a token with: openssl rand -hex 32
NEXUS_API_TOKEN=
# Optional: override the default ./data/models/Qwen2.5-0.5B-Instruct-Q4_K_M.gguf
NEXUS_MODEL_PATH=
# Optional: override the conservative automatic context selection (1024-4096 tokens)
NEXUS_CONTEXT_TOKENS=
# Optional: override the llama.cpp server URL
NEXUS_INFERENCE_URL=http://127.0.0.1:8081
